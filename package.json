{
  "name": "vulnfocus",
  "version": "2.0.0",
  "private": true,
  "description": "VulnFocus SPA \u2014 React (Static Assets) + Cloudflare Worker + D1",
  "scripts": {
    "dev": "wrangler dev --env staging",
    "build": "npm run install:frontend && npm run build:frontend",
    "install:frontend": "npm --prefix frontend ci",
    "build:frontend": "npm --prefix frontend run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy:staging": "npm run build && wrangler deploy --env staging",
    "deploy:production": "npm run build && wrangler deploy --env production",
    "db:migrate:staging": "wrangler d1 migrations apply vulnfocus-staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply vulnfocus --remote",
    "db:migrate:local": "wrangler d1 migrations apply vulnfocus-staging --local",
    "db:backup": "bash scripts/d1-backup.sh",
    "smoke": "bash scripts/acceptance-test.sh --auto-only",
    "telegram:check": "node scripts/telegram-check.mjs",
    "tail:staging": "wrangler tail --env staging",
    "tail:production": "wrangler tail --env production",
    "acceptance": "bash scripts/acceptance-test.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.36.0"
  }
}
