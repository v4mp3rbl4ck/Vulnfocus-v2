{
  "name": "vulnfocus",
  "version": "2.0.0",
  "private": true,
  "description": "VulnFocus SPA — React (Static Assets) + Cloudflare Worker + D1",
  "scripts": {
    "dev": "wrangler dev",
    "build": "npm run install:frontend && npm run build:frontend && npm run build:site",
    "install:frontend": "npm --prefix frontend ci",
    "build:frontend": "npm --prefix frontend run build",
    "build:site": "node scripts/build-site.mjs",
    "build:site:check": "node scripts/build-site.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "deploy": "npm run build && wrangler deploy",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "db:migrate": "wrangler d1 migrations apply vulnfocus-production --remote",
    "db:migrate:list": "wrangler d1 migrations list vulnfocus-production --remote",
    "db:migrate:local": "wrangler d1 migrations apply vulnfocus-production --local",
    "db:backup": "bash scripts/d1-backup.sh vulnfocus-production",
    "smoke": "bash scripts/acceptance-test.sh --auto-only",
    "telegram:check": "node scripts/telegram-check.mjs",
    "tail": "wrangler tail",
    "acceptance": "bash scripts/acceptance-test.sh"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.36.0"
  }
}
