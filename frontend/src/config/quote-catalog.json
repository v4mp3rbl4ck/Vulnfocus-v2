{
  "_comment": "CATÁLOGO PÚBLICO DEL COTIZADOR. Fuente única de las preguntas del wizard. Lo importa el frontend (para renderizar) y el Worker (como allowlist de validación), desde este mismo fichero, para que no puedan desincronizarse. NO contiene horas, tarifas, multiplicadores ni ningún dato comercial: eso vive en worker/config/quote-config.js y nunca llega al navegador.",
  "version": 1,
  "maxServices": 3,
  "steps": ["service", "scope", "context", "contact", "estimate"],

  "services": [
    {
      "id": "web",
      "icon": "Globe",
      "labels": { "es": "Pentesting Web", "en": "Web Pentesting" },
      "summary": {
        "es": "Aplicaciones web, portales y paneles administrativos.",
        "en": "Web applications, portals and admin panels."
      },
      "questions": [
        { "id": "apps", "type": "number", "min": 1, "max": 50, "default": 1,
          "labels": { "es": "¿Cuántas aplicaciones web entran en el alcance?", "en": "How many web applications are in scope?" } },
        { "id": "roles", "type": "number", "min": 1, "max": 20, "default": 2,
          "labels": { "es": "¿Cuántos roles de usuario distintos hay que probar?", "en": "How many distinct user roles must be tested?" },
          "help": { "es": "Anónimo, usuario, administrador… Cada rol multiplica las pruebas de control de acceso.", "en": "Anonymous, user, admin… Each role multiplies access control testing." } },
        { "id": "auth", "type": "select", "default": "password",
          "labels": { "es": "¿Cómo se autentican los usuarios?", "en": "How do users authenticate?" },
          "options": [
            { "value": "none", "labels": { "es": "No hay autenticación", "en": "No authentication" } },
            { "value": "password", "labels": { "es": "Usuario y contraseña", "en": "Username and password" } },
            { "value": "mfa", "labels": { "es": "Con segundo factor (MFA)", "en": "With second factor (MFA)" } },
            { "value": "sso", "labels": { "es": "SSO corporativo (SAML/OIDC)", "en": "Corporate SSO (SAML/OIDC)" } }
          ] },
        { "id": "endpoints", "type": "select", "default": "lt50",
          "labels": { "es": "Volumen aproximado de funcionalidad", "en": "Approximate functionality volume" },
          "help": { "es": "Pantallas o endpoints distintos, contando solo lo que entra en el alcance.", "en": "Distinct screens or endpoints, counting only what is in scope." },
          "options": [
            { "value": "lt50", "labels": { "es": "Menos de 50", "en": "Fewer than 50" } },
            { "value": "50_150", "labels": { "es": "Entre 50 y 150", "en": "Between 50 and 150" } },
            { "value": "150_400", "labels": { "es": "Entre 150 y 400", "en": "Between 150 and 400" } },
            { "value": "gt400", "labels": { "es": "Más de 400", "en": "More than 400" } }
          ] },
        { "id": "api_asociada", "type": "boolean", "default": false,
          "labels": { "es": "¿La aplicación tiene una API propia que también debe evaluarse?", "en": "Does the application have its own API that must also be assessed?" } },
        { "id": "waf", "type": "boolean", "default": false,
          "labels": { "es": "¿Hay un WAF u otra protección delante?", "en": "Is there a WAF or similar protection in front?" },
          "help": { "es": "Sin lista blanca para el equipo de pruebas, el WAF añade trabajo de evasión.", "en": "Without an allowlist for the testing team, a WAF adds evasion work." } },
        { "id": "environment", "type": "select", "default": "staging",
          "labels": { "es": "¿En qué entorno se ejecutan las pruebas?", "en": "Which environment will be tested?" },
          "options": [
            { "value": "staging", "labels": { "es": "Staging o preproducción", "en": "Staging or pre-production" } },
            { "value": "production", "labels": { "es": "Producción", "en": "Production" } },
            { "value": "both", "labels": { "es": "Ambos", "en": "Both" } }
          ] },
        { "id": "stack", "type": "multiselect", "default": [],
          "labels": { "es": "Tecnologías, si las conoces", "en": "Technologies, if you know them" },
          "help": { "es": "Opcional. Solo se usa para dimensionar; no afecta al alcance declarado.", "en": "Optional. Used only for sizing; it does not change the declared scope." },
          "options": [
            { "value": "spa", "labels": { "es": "SPA (React, Vue, Angular)", "en": "SPA (React, Vue, Angular)" } },
            { "value": "server_rendered", "labels": { "es": "Renderizado en servidor", "en": "Server rendered" } },
            { "value": "cms", "labels": { "es": "CMS (WordPress, Drupal…)", "en": "CMS (WordPress, Drupal…)" } },
            { "value": "legacy", "labels": { "es": "Aplicación heredada", "en": "Legacy application" } },
            { "value": "microservices", "labels": { "es": "Microservicios", "en": "Microservices" } }
          ] }
      ]
    },

