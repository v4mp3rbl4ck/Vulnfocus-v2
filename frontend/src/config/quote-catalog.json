            { "value": "few", "labels": { "es": "Entre 1 y 3", "en": "Between 1 and 3" } },
            { "value": "many", "labels": { "es": "Más de 3", "en": "More than 3" } }
          ] },
        { "id": "environment", "type": "select", "default": "staging",
          "labels": { "es": "¿En qué entorno se ejecutan las pruebas?", "en": "Which environment will be tested?" },
          "options": [
            { "value": "staging", "labels": { "es": "Staging o preproducción", "en": "Staging or pre-production" } },
            { "value": "production", "labels": { "es": "Producción", "en": "Production" } },
            { "value": "both", "labels": { "es": "Ambos", "en": "Both" } }
          ] }
      ]
    },

