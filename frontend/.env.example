# Copiar a .env (NO versionar .env) para desarrollo local del frontend.
# Solo variables PÚBLICAS: CRA las incrusta en el bundle JavaScript.
# Nunca poner aquí secretos de Turnstile, Telegram ni Cloudflare.

# Site key de Turnstile. Es público por diseño.
# Clave de PRUEBA que siempre pasa la validación (documentación oficial de Cloudflare):
REACT_APP_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# En producción usa el site key real de tu widget:
# REACT_APP_TURNSTILE_SITE_KEY=0x4AAAAAAA...

# Evita que CRA incruste el runtime chunk como <script> inline en index.html.
# Necesario para que la CSP funcione sin 'unsafe-inline' en script-src.
INLINE_RUNTIME_CHUNK=false
