# Variables de build para producción. Se versionan porque NO son secretas:
# CRA incrusta todo lo que empieza por REACT_APP_ en el bundle público.

# Impide que CRA inyecte el runtime chunk como <script> inline en index.html.
# Sin esto, la CSP necesitaría 'unsafe-inline' en script-src.
INLINE_RUNTIME_CHUNK=false

# No publicar source maps: evita exponer el código fuente original en producción.
GENERATE_SOURCEMAP=false

# Site key público de Turnstile. Reemplazar por el real antes del primer deploy.
REACT_APP_TURNSTILE_SITE_KEY=REEMPLAZAR_CON_TU_SITE_KEY_DE_TURNSTILE
