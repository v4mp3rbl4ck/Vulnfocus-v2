{
  "name": "vulnfocus-v2",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-25",

  "assets": {
    "directory": "./frontend/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },

  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vulnfocus-production",
      "database_id": "cdd86698-d6f3-44d9-a0f9-55f06f4c6351",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "STORE_IP": "false",
    "TURNSTILE_ALLOWED_HOSTNAMES": "vulnfocus.com,www.vulnfocus.com,vulnfocus-v2.jesus62175.workers.dev"
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
