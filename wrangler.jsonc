{
  // ---------------------------------------------------------------------------
  // FUENTE ÚNICA DE CONFIGURACIÓN — ESTE NIVEL RAÍZ **ES** PRODUCCIÓN.
  //
  // No existen bloques `env.*`. El despliegue real es:
  //
  //     GitHub → Cloudflare Workers Builds → vulnfocus-v2 → vulnfocus.com
  //
  // Por eso `package.json` NO tiene scripts con `--env staging|production`:
  // pasar `--env` a un fichero sin entornos produce una configuración distinta
  // (Worker con nombre `vulnfocus-v2-staging`, sin D1 y sin rate limiters) y el
  // despliegue "funciona" mientras la aplicación queda a medias.
  //
  // Si algún día hace falta staging, ver docs/CLOUDFLARE_DEPLOYMENT.md §Staging:
  // se añade como Worker aparte, no complicando este fichero.
  // ---------------------------------------------------------------------------
  "name": "vulnfocus-v2",
  "main": "worker/index.js",
  "compatibility_date": "2026-08-25",

  // El sitio se sirve EXCLUSIVAMENTE desde vulnfocus.com / www.vulnfocus.com.
  //
  // `workers_dev: false` retira vulnfocus-v2.<subdominio>.workers.dev. No es
  // cosmético: ese hostname ya no está en TURNSTILE_ALLOWED_HOSTNAMES, así que
  // seguiría publicando una copia navegable del sitio con TODOS los formularios
  // devolviendo 403. Mejor que no exista.
  //
  // ROLLBACK: poner "workers_dev": true y desplegar. Necesario si el dominio
  // personalizado no estuviera asociado en el panel (Workers & Pages →
  // vulnfocus-v2 → Settings → Domains & Routes), porque entonces workers.dev
  // sería el único acceso. Verificar ANTES de desplegar este cambio:
  // docs/CLOUDFLARE_MANUAL_ACTIONS.md → M-04.
  "workers_dev": false,

  "assets": {
    "directory": "./frontend/build",
    "binding": "ASSETS",

    // "404-page" en lugar de "single-page-application".
    //
    // Con "single-page-application" CUALQUIER ruta devolvía 200 + index.html:
    // /wp-admin, /.env o /backup parecían recursos reales. El conjunto de rutas
    // públicas es finito y conocido, así que scripts/build-site.mjs materializa
    // un HTML por ruta declarada en frontend/src/config/site.json; lo que no
    // existe como asset cae en 404.html y devuelve un 404 real.
    //
    // Es una allowlist por construcción, no una lista negra de nombres comunes,
    // y sigue sin invocar el Worker para tráfico estático.
    //
    // ROLLBACK: volver a "single-page-application" restaura el comportamiento
    // anterior sin tocar nada más.
    "not_found_handling": "404-page",

    // El Worker atiende /api/* y también /admin*.
    //
    // /admin* NO es un asset: si lo fuera, existiría como fichero y Cloudflare lo
    // serviría con 200 a cualquiera, dejando la protección en manos exclusivas de
    // Access sobre el subdominio. Pasando por el Worker, /admin devuelve 404 con
    // ADMIN_ENABLED="false" y sigue devolviendo 404 sin aserción válida de Access.
    "run_worker_first": [
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },

  "ratelimits": [
    {
      "name": "CONTACT_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      // Cotizador: superficie pública que escribe en D1. Límite más estricto que
      // el de contacto porque una cotización legítima se envía una vez.
      "name": "QUOTE_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 3,
        "period": 60
      }
    },
    {
      // Lectura de estimaciones por public_id. Amortigua intentos de fuerza
      // bruta sobre el identificador (que ya es de 128 bits aleatorios).
      "name": "QUOTE_READ_RATE_LIMITER",
      "namespace_id": "1003",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      // Administración. Sigue detrás de Cloudflare Access, pero un limitador
      // propio evita que una sesión legítima (o un token filtrado) pueda barrer
      // la tabla completa a base de paginar.
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "1004",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vulnfocus-production",
      "database_id": "cdd86698-d6f3-44d9-a0f9-55f06f4c6351",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "STORE_IP": "false",

    // Allowlist EXACTA de hostnames que Siteverify puede devolver. Solo
    // producción: los hostnames de desarrollo (localhost, 127.0.0.1) viven en
    // .dev.vars, que no se despliega.
    "TURNSTILE_ALLOWED_HOSTNAMES": "vulnfocus.com,www.vulnfocus.com",

    // ---- Cotizador ------------------------------------------------------
    // "true" habilita el cálculo y la exposición del rango económico. Requiere
    // que worker/config/quote-config.js tenga tarifas reales configuradas.
    // Con "false" (por defecto) la estimación devuelve esfuerzo y duración,
    // pero NO precios: es la única forma de no inventar valores comerciales.
    "PRICING_ENABLED": "false",
    "QUOTE_DEFAULT_CURRENCY": "CLP",

    // ---- Integraciones (ver docs/INTEGRATIONS.md) ------------------------
    // "null" = adaptador inerte que solo registra. Cambiar a "resend" o
    // "mailchannels" cuando exista proveedor y credenciales.
    "EMAIL_PROVIDER": "null",
    "EMAIL_FROM": "",
    "EMAIL_INTERNAL_TO": "",
    // "null" hasta que se decida un CRM. No se selecciona ninguno por defecto.
    "CRM_PROVIDER": "null",
    // SysReptor queda deshabilitado hasta decisión explícita del propietario.
    "SYSREPTOR_ENABLED": "false",

    // ---- Administración (ver docs/ADMIN.md) ------------------------------
    // DESHABILITADA POR DEFECTO Y A PROPÓSITO. Con "false" todo /api/admin/*
    // responde 404, exactamente igual que cualquier otra ruta inexistente.
    //
    // NO poner "true" hasta que Cloudflare Access proteja el subdominio:
    // docs/CLOUDFLARE_MANUAL_ACTIONS.md → M-05. El Worker además exige la
    // aserción de identidad de Access (Cf-Access-Jwt-Assertion) y no arranca la
    // administración sin CF_ACCESS_TEAM_DOMAIN y CF_ACCESS_AUD.
    "ADMIN_ENABLED": "false",
    // Dominio del equipo de Cloudflare Access, p. ej. "vulnfocus.cloudflareaccess.com".
    "CF_ACCESS_TEAM_DOMAIN": "",
    // Audience (AUD) tag de la aplicación de Access. No es un secreto, pero sí
    // un identificador que debe coincidir exactamente.
    "CF_ACCESS_AUD": "",
    // Allowlist OPCIONAL de correos, separados por comas, además de la política
    // de Access. Vacío = se confía solo en Access. Es defensa en profundidad
    // para el caso de una política de Access demasiado amplia.
    "ADMIN_ALLOWED_EMAILS": ""
  },

  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
